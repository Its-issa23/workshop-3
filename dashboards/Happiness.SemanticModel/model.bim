        "lineageTag": "f9f9cfd6-f6bf-4934-aaea-bc0ac0a5078f",
        "measures": [
          {
            "name": "Predicciones",
            "expression": "COUNTROWS(Predicciones)",
            "formatString": "0",
            "lineageTag": "bd214b3c-73d8-4e63-8c21-ac06053a39f9"
          },
          {
            "name": "MAE",
            "expression": "AVERAGE(Predicciones[absolute_error])",
            "formatString": "0.000",
            "lineageTag": "660ff26c-ee3c-44de-a4b0-67414ec4a275"
          },
          {
            "name": "Error promedio",
            "expression": "AVERAGE(Predicciones[prediction_error])",
            "formatString": "0.000",
            "lineageTag": "81f89f6b-0820-490a-84d2-1f8e0f487fac"
          },
          {
            "name": "RMSE",
            "expression": "SQRT(AVERAGEX(Predicciones,POWER(Predicciones[prediction_error],2)))",
            "formatString": "0.000",
            "lineageTag": "0ab6f8cd-d0fc-4a8c-b392-87a9ae0c2c33"
          },
          {
            "name": "Puntaje real",
            "expression": "AVERAGE(Predicciones[actual_score])",
            "formatString": "0.00",
            "lineageTag": "2dd04df6-4fe8-45d5-ae42-d0948536a5a2"
          },
          {
            "name": "Puntaje predicho",
            "expression": "AVERAGE(Predicciones[predicted_score])",
            "formatString": "0.00",
            "lineageTag": "1ec1022a-09d8-4367-a8de-4866069206c4"
          },
          {
            "name": "MAE prueba 2019",
            "expression": "CALCULATE([MAE],Predicciones[evaluation_split]=\"test\")",
            "formatString": "0.000",
            "lineageTag": "b3aca437-8114-4290-a300-54222fd954d0"
          },
          {
            "name": "Latencia media ms",
            "expression": "AVERAGE(Predicciones[latency_ms])",
            "formatString": "0.0",
            "lineageTag": "d7b51729-1fef-42d4-aedd-c6e5df5fcf33"
          }
        ],
        "partitions": [
          {
            "name": "Predicciones",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"happiness\", [CreateNavigationProperties=false]),",
